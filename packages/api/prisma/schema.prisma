generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserType {
  ADMIN
  OFFICER
}

enum LeadStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String
  userType     UserType @default(OFFICER)
  createdAt    DateTime @default(now())
  leads        Lead[]
}

model Lead {
  id            Int        @id @default(autoincrement())
  borrowerName  String
  borrowerPhone String
  amount        Int // minor units (cents)
  status        LeadStatus @default(PENDING)
  officer       User       @relation(fields: [officerId], references: [id])
  officerId     Int
  createdAt     DateTime   @default(now())
}
